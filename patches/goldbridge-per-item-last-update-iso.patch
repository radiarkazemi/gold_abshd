diff --git a/app/services/timeutil.py b/app/services/timeutil.py
new file mode 100644
index 0000000..96a09f9
--- /dev/null
+++ b/app/services/timeutil.py
@@ -0,0 +1,44 @@
+"""Timestamp helpers for sekefarshad / goldbridge.
+
+sekefarshad's ``lastUpdateTime`` is an Asia/Tehran *wall clock* string
+(e.g. ``\"2026-08-10 13:27:33\"``) with no timezone suffix. Consumers that
+treat it as UTC will display the wrong local time (+3:30 / +4:30).
+
+Always normalize to ISO-8601 *with* an explicit Asia/Tehran offset before
+exposing it on /price or /prices.
+"""
+from __future__ import annotations
+
+from datetime import datetime
+from zoneinfo import ZoneInfo
+
+TEHRAN = ZoneInfo("Asia/Tehran")
+
+
+def normalize_source_timestamp(value) -> str | None:
+    """Return ISO-8601 with Asia/Tehran offset, or None if unparseable."""
+    if value is None:
+        return None
+    s = str(value).strip()
+    if not s:
+        return None
+    if " " in s and "T" not in s:
+        s = s.replace(" ", "T", 1)
+
+    try:
+        # Already has an explicit zone / offset — keep absolute instant.
+        if s.endswith(("Z", "z")) or (
+            len(s) > 10 and (s[-6] in "+-" or s[-5] in "+-") and (":" in s[-6:] or s[-3:].isdigit())
+        ):
+            if s.endswith(("Z", "z")):
+                s = s[:-1] + "+00:00"
+            dt = datetime.fromisoformat(s)
+            if dt.tzinfo is None:
+                dt = dt.replace(tzinfo=TEHRAN)
+            return dt.astimezone(TEHRAN).isoformat()
+
+        # Naive → Asia/Tehran wall clock from sekefarshad.
+        dt = datetime.fromisoformat(s).replace(tzinfo=TEHRAN)
+        return dt.isoformat()
+    except ValueError:
+        return None
