# Tahesab (ته‌حساب) — recommended: direct (support guide)
# VPS POSTs to your public/static IP:8081. Jobs queue in outbox and retry
# automatically when the Windows PC comes online. No pull agent needed.
#
# Windows / modem checklist (from Tahesab support):
# 1) API plugin active in ته حساب (پرونده → API), token + port 8081
# 2) Static public IP from ISP
# 3) Modem port-forward 8081 → PC LAN IP
# 4) Windows firewall / antivirus allow 8081
# 5) In Tahesab API settings, do NOT bind only to 127.0.0.1 —
#    use 0.0.0.0 or the PC's LAN IP so port-forward can reach it
#
# Then set BASE_URL to https://YOUR.STATIC.IP:8081 (or http://...:9550)

GOLDAPP_TAHESAB_ENABLED=true
GOLDAPP_TAHESAB_MODE=direct
GOLDAPP_TAHESAB_BASE_URL=https://YOUR.STATIC.IP:8081
GOLDAPP_TAHESAB_TOKEN=
GOLDAPP_TAHESAB_DBNAME=DB
GOLDAPP_TAHESAB_VERIFY_SSL=false
GOLDAPP_TAHESAB_AMOUNT_SCALE=10
GOLDAPP_TAHESAB_DEFAULT_GROUP=اپلیکیشن
GOLDAPP_TAHESAB_SABTE_KOL=1
GOLDAPP_TAHESAB_IS_ABSHODE=1
GOLDAPP_TAHESAB_TIMEOUT=20
GOLDAPP_TAHESAB_OUTBOX_POLL_SECONDS=15

# Optional fallback only (no port-forward): MODE=bridge + BRIDGE_TOKEN
# GOLDAPP_TAHESAB_MODE=bridge
# GOLDAPP_TAHESAB_BRIDGE_TOKEN=
