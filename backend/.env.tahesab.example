# Tahesab (ته‌حساب) — copy into backend/.env (gitignored) on the machine
# that can reach the Windows API. Do NOT commit real tokens.
#
# Local Windows (same PC as Tahesab):
#   GOLDAPP_TAHESAB_BASE_URL=https://127.0.0.1:8081
#   # or HTTP: http://127.0.0.1:9550
#
# Remote app (VPS): put the Windows LAN/public IP (or VPN) — NOT 127.0.0.1.
# Activate a real TLS cert on Tahesab, then set VERIFY_SSL=true.

GOLDAPP_TAHESAB_ENABLED=false
# bridge = Windows agent pulls jobs (required when API is only on 127.0.0.1)
# direct = VPS posts to BASE_URL (needs reachable host/IP)
GOLDAPP_TAHESAB_MODE=bridge
GOLDAPP_TAHESAB_BASE_URL=https://127.0.0.1:8081
GOLDAPP_TAHESAB_TOKEN=
GOLDAPP_TAHESAB_DBNAME=DB
GOLDAPP_TAHESAB_BRIDGE_TOKEN=
GOLDAPP_TAHESAB_VERIFY_SSL=false
GOLDAPP_TAHESAB_AMOUNT_SCALE=10
GOLDAPP_TAHESAB_DEFAULT_GROUP=اپلیکیشن
GOLDAPP_TAHESAB_SABTE_KOL=1
GOLDAPP_TAHESAB_IS_ABSHODE=1
GOLDAPP_TAHESAB_TIMEOUT=20
