# Tahesab — TEST books only (never main shop data)
#
# You have two Tahesab apps on the PC. Enable API ONLY on the TEST one.
# The agent refuses to write if CheckHealth DBName is not allow-listed.

GOLDAPP_TAHESAB_ENABLED=true
GOLDAPP_TAHESAB_MODE=bridge
GOLDAPP_TAHESAB_BASE_URL=https://127.0.0.1:8081
GOLDAPP_TAHESAB_TOKEN=

# Header DBName for the TEST environment (Access folder or SQL db name).
# Access main is usually "DB"; test env is often "DB1".
# If your TEST install is a separate app with its own Access folder still
# named "DB", keep DB and rely on "API only on test" + allow-list below.
GOLDAPP_TAHESAB_DBNAME=DB
GOLDAPP_TAHESAB_TARGET_LABEL=تست

# CheckHealth.DBName must match one of these (case-insensitive) or agent stops.
GOLDAPP_TAHESAB_ALLOWED_DBNAMES=db
# Never write if CheckHealth reports these (typical SQL main db names).
GOLDAPP_TAHESAB_BLOCKED_DBNAMES=TahesabDB

GOLDAPP_TAHESAB_BRIDGE_TOKEN=
GOLDAPP_TAHESAB_VERIFY_SSL=false
GOLDAPP_TAHESAB_AMOUNT_SCALE=10
GOLDAPP_TAHESAB_DEFAULT_GROUP=اپلیکیشن
GOLDAPP_TAHESAB_SABTE_KOL=1
GOLDAPP_TAHESAB_IS_ABSHODE=1
GOLDAPP_TAHESAB_TIMEOUT=20
